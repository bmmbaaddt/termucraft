{
  "name": "termucraft",
  "version": "1.0.1",
  "description": "Open-source Windows workstation for remote work: SSH/SFTP/WSL/serial terminals, tunnels, macros and a full database workbench (PostgreSQL, MySQL/MariaDB, Oracle, SQL Server, SQLite) with an encrypted vault.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/core.test.js test/db.test.js test/moba-crypto.test.js test/moba-import.test.js test/dbeaver.test.js test/moba-files.test.js",
    "smoke": "electron . --smoke",
    "icon": "node build/gen-icon.js",
    "dist": "node build/gen-icon.js && electron-builder --win --publish never",
    "dist:portable": "node build/gen-icon.js && electron-builder --win portable --publish never"
  },
  "author": "TermuCraft contributors",
  "license": "MIT",
  "build": {
    "appId": "com.termucraft.app",
    "productName": "TermuCraft",
    "npmRebuild": false,
    "files": [
      "main.js",
      "preload.js",
      "core/**/*",
      "renderer/**/*",
      "test/fake-sshd.js",
      "!**/*.map",
      "LICENSE"
    ],
    "extraMetadata": {
      "main": "main.js"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "TermuCraft-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TermuCraft"
    },
    "portable": {
      "artifactName": "TermuCraft-${version}-portable.exe"
    },
    "asarUnpack": [
      "**/node_modules/node-pty/**",
      "**/node_modules/oracledb/**",
      "**/node_modules/@serialport/**",
      "**/node_modules/serialport/**",
      "**/node_modules/odbc/**"
    ]
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^5.65.21",
    "mssql": "^12.7.4",
    "mysql2": "^3.24.5",
    "node-pty": "^1.1.0",
    "odbc": "^2.6.0",
    "oracledb": "^7.0.1",
    "pg": "^8.23.1",
    "pg-cursor": "^2.15.3",
    "serialport": "^13.0.0",
    "sql-formatter": "^15.4.0",
    "ssh2": "^1.17.0"
  },
  "productName": "TermuCraft",
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "keywords": [
    "ssh",
    "sftp",
    "terminal",
    "electron",
    "database",
    "sql",
    "postgresql",
    "mysql",
    "oracle",
    "sqlserver",
    "sqlite",
    "wsl",
    "windows"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/bmmbaaddt/termucraft.git"
  },
  "homepage": "https://github.com/bmmbaaddt/termucraft",
  "bugs": {
    "url": "https://github.com/bmmbaaddt/termucraft/issues"
  }
}
